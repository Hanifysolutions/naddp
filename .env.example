# ===========================================================================
# NADDP — Nigeria-Australia Digital Diplomacy Platform (Ambassador demo)
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------
# SECURITY BOUNDARY — READ THIS FIRST
#   ANTHROPIC_API_KEY (and every other secret below) is SERVER-SIDE ONLY.
#   It is read by apps/api and must NEVER be exposed to the browser bundle.
#   In Next.js ONLY variables prefixed with NEXT_PUBLIC_ reach the client.
#   Therefore: never rename a secret to NEXT_PUBLIC_*, and never import a
#   secret into apps/web. The Anthropic SDK is imported in exactly one file
#   in this repo: apps/api/app/ai/gateway.py (BUILD_BIBLE §4).
#   `.env` is git-ignored. Do not commit real keys.
# ===========================================================================

# PostgreSQL connection string used by SQLAlchemy 2.0 + Alembic (psycopg 3 driver).
DATABASE_URL=postgresql+psycopg://naddp:naddp@localhost:5433/naddp

# Anthropic API key — SERVER-SIDE ONLY, consumed exclusively by the AI Gateway.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Base URL of the FastAPI service as seen by the browser (NEXT_PUBLIC_ = public).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Master demo switch: synthetic data only, DEMO/SYNTHETIC badge forced on every screen.
DEMO_MODE=true

# Secret used by itsdangerous to sign the `naddp_demo_session` role-picker cookie.
# This literal is a KNOWN PLACEHOLDER: the API refuses to boot with it (or with any
# secret under 32 characters) unless APP_ENV is local or test. Generate a real one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DEMO_SESSION_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call the API with credentials.
# The demo session cookie only survives a cross-origin request when the origin is listed
# here explicitly. A `*` here is not a shortcut: the API drops `allow_credentials` when it
# sees a wildcard, so the role picker silently stops working.
# All three are the same machine. Which one the browser sends depends on what was typed
# and on how the host resolves `localhost` (Windows tries ::1 first), so allowing one of
# them makes the demo work or fail on a detail nobody chose.
# A deployed API must replace this with the real web origin - it refuses to boot with
# these values when APP_ENV is not local.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://[::1]:3000

# When false the AI Gateway returns deterministic cached snapshots instead of calling Anthropic (Week 1 default).
AI_GATEWAY_LIVE=false

# Hard timeout for a live model call; on timeout the gateway serves its deterministic fallback.
AI_GATEWAY_TIMEOUT_SECONDS=4

# Anthropic model id for the STRONG tier (briefs, meeting prep, grounded answers).
# BUILD_BIBLE 4a: sensitivity is the primary routing key, capability tier the secondary one.
ANTHROPIC_MODEL=claude-sonnet-5

# Anthropic model id for the FAST tier (classify/score, matching). 4a again.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Deployment environment name: local | staging | production.
APP_ENV=local

# Local object-storage root for demo documents; `documents.object_uri` points inside it.
STORAGE_DIR=./storage

# structlog level for the API: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Port the FastAPI service listens on.
API_PORT=8000

# Port the Next.js dev server listens on.
WEB_PORT=3000

# Host port mapped to the Postgres container (5432 is already taken on the build machine).
# DOCUMENTATION ONLY - nothing reads this. docker-compose.yml hard-codes "5433:5432" and
# DATABASE_URL above carries the port. Change it here and you must change it in both.
POSTGRES_PORT=5433
