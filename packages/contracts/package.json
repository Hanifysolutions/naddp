{
  "name": "@naddp/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Generated OpenAPI types + typed fetch client for the NADDP API. Source-only workspace package; consumers transpile it via Next transpilePackages.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./generated": {
      "types": "./src/generated/openapi.d.ts",
      "default": "./src/generated/openapi.d.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "node ./scripts/generate-types.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3"
  }
}
