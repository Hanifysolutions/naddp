# ---------------------------------------------------------------------------
# NADDP — repository ignore rules
# ---------------------------------------------------------------------------

# --- Node / pnpm ---
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*
.npm/

# --- Next.js / build output ---
.next/
out/
dist/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Test / coverage ---
coverage/
.nyc_output/
junit.xml
.playwright/
test-results/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.eggs/
*.egg

# --- Environment files (NEVER commit real secrets) ---
# .env.example IS committed — it is the documented template.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# --- OS cruft ---
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# --- Local object storage for demo documents (keep the directory, not its contents) ---
/storage/*
!/storage/.gitkeep
!/storage/README.md

# --- Generated seed manifest (produced by `make seed`) ---
# Maps stable seed slugs to the primary keys of the current dataset, so an eval case
# or a demo script can name `opp-au-lithium-ng-skills-corridor` rather than a UUID.
# NOT committed: the identifiers are a pure function of the slug and so are reproduced
# identically by any `make seed`, while the `cases.public_ref` values it also records
# are CSPRNG-minted (ADR-0007) and legitimately change on every `make demo-reset`.
# Committing it would therefore add churn and no information. Run `make seed` to
# produce it; anything that reads it runs after the seed by definition.
data/demo-seed/manifest.json

# --- Generated OpenAPI contract output (produced by `make gen-client`) ---
# NOTE: packages/contracts/src/generated/openapi.d.ts IS committed on purpose.
# It is the placeholder `packages/contracts/src/index.ts` imports, so a fresh
# clone typechecks and `next build` succeeds before the API has ever been run;
# generation overwrites it in place. Ignoring the whole directory made every
# fresh clone (and CI) fail on an unresolved `./generated/openapi` import.
packages/contracts/openapi.json
packages/contracts/src/generated/api.ts

# --- Local docker / database scratch ---
.pgdata/
*.sqlite
*.sqlite3
*.db-journal

# --- Misc ---
*.log
.tmp/
tmp/
